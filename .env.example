# Copy this file to `.env` (it is gitignored), change DB_PASSWORD and generate AUTH_SECRET.
# `docker compose up` creates the database and user from these values.

DB_USER=exchange_ops_user
DB_PASSWORD=change-me
DB_NAME=exchange_ops
# Host port the MariaDB container is published on (3307 avoids clashing with a local MariaDB/MySQL)
DB_PORT=3307

# Port the app is served on: http://localhost:<APP_PORT>
APP_PORT=4001

# --- Auth (rs-auth) ---
# Signs the session cookie. At least 64 characters; generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Local development account seeded at startup (email verification is skipped for this account).
DEV_SEED_EMAIL=test@example.com
DEV_SEED_PASSWORD=local-test-password
# Public URL of this app, used in the links of verification and password-reset emails
APP_PUBLIC_URL=http://localhost:4001

# --- Email ---
# Dev inbox for sign-up and password-reset emails: http://localhost:<MAILCRAB_PORT>
MAILCRAB_PORT=1080
# SMTP settings for running the app natively (docker compose points the app at mailcrab).
# SMTP_TLS is one of: none, starttls, tls
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Exchange-Ops <no-reply@localhost>

# Used when running the app or Diesel CLI natively on your machine. Set the
# username, password, and port here to match the values above. (Use 127.0.0.1,
# not localhost: the MySQL client treats localhost as a Unix socket.)
# Compose overrides this with the `db` service address.
DATABASE_URL=mysql://exchange_ops_user:change-me@127.0.0.1:3307/exchange_ops
